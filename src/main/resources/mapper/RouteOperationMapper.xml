<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.transit.SGComplaint.mapper.RouteOperationMapper">
    <resultMap id="routeOperationMap" type="com.transit.SGComplaint.domain.RouteOperation">
        <id property="routeNo" column="route_no"/>
        <result property="routeType" column="route_type"/>
        <result property="busName" column="bus_name"/>
        <result property="terminalInfo" column="terminal_info"/>
        <result property="dispatchInterval" column="dispatch_interval"/>
        <result property="inquiryPhone" column="inquiry_phone"/>
        <result property="routeUrl" column="route_url"/>
        <result property="status" column="route_status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findActiveByType" resultMap="routeOperationMap">
        SELECT route_no, route_type, bus_name, terminal_info, dispatch_interval, inquiry_phone, route_url, route_status, created_at, updated_at
        FROM sgtransit_route_operation
        WHERE route_status = 'Y'
          AND route_type = #{routeType}
        ORDER BY route_no ASC
    </select>

    <select id="countActiveByType" resultType="long">
        SELECT COUNT(*)
        FROM sgtransit_route_operation
        WHERE route_status = 'Y'
          AND route_type = #{routeType}
    </select>
</mapper>
