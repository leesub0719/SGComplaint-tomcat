<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.transit.SGComplaint.repository.DdokBusGuideImageRepository">
  <resultMap id="image" type="com.transit.SGComplaint.domain.DdokBusGuideImage"><id property="imageNo" column="image_no"/><result property="originalName" column="original_name"/><result property="storedName" column="stored_name"/><result property="filePath" column="file_path"/><result property="contentType" column="content_type"/><result property="fileSize" column="file_size"/><result property="createdAt" column="created_at"/></resultMap>

    <select id="findById" resultMap="image">
        SELECT *
        FROM sgtransit_ddokbus_guide_image
        WHERE image_no=#{imageNo}
    </select>

    <insert id="insertImage" useGeneratedKeys="true" keyProperty="imageNo" keyColumn="image_no">
        INSERT INTO sgtransit_ddokbus_guide_image (
            original_name,
            stored_name,
            file_path,
            content_type,
            file_size,
            created_at
        ) VALUES (
            #{originalName},
            #{storedName},
            #{filePath},
            #{contentType},
            #{fileSize},
            CURRENT_TIMESTAMP
        )
    </insert>

    <delete id="deleteById">
        DELETE
        FROM sgtransit_ddokbus_guide_image
        WHERE image_no=#{imageNo}
    </delete>
</mapper>
