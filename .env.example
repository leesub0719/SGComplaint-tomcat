# 이 파일은 변수 이름 예시일 뿐이며 실제 비밀값을 입력해 커밋하지 마세요.
# Spring Boot를 로컬에서 실행하기 전에 현재 셸 또는 Eclipse Run Configuration에 설정합니다.

SPRING_PROFILES_ACTIVE=local
DB_NAME=sgcomplaint
DB_USERNAME=root
DB_PASSWORD=change-me

REMEMBER_ME_KEY=replace-with-at-least-32-random-characters

# 문자 발송 기능을 사용하는 경우에만 설정합니다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

# 운영/외부 Tomcat에서는 반드시 절대경로를 사용합니다.
COMPLAINT_UPLOAD_DIR=C:/sgcomplaint-data/uploads/complaints
ANSWER_UPLOAD_DIR=C:/sgcomplaint-data/uploads/answers
NOTICE_IMAGE_UPLOAD_DIR=C:/sgcomplaint-data/uploads/notices
MAIN_BANNER_UPLOAD_DIR=C:/sgcomplaint-data/uploads/main-banners
DDOKBUS_GUIDE_DIR=C:/sgcomplaint-data/uploads/routes/ddokbus
